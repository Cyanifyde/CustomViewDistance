		{
			"config": "playerviewdistance.mixins.json",
			"environment": "server"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_dependency}",
		"fabric-api": "*"
	}
}
